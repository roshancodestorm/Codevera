# Codevora AI Environment Variables
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# 1. AI Models & Providers
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# 2. Supabase Auth Configuration (Client-side / Public)
# NEVER put your SUPABASE_SERVICE_ROLE_KEY here!
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# 3. Transactional Email System (Server-side / Confidential)
# Required for sending branded welcome emails to verified & OAuth users.
# Configure ONE of the two providers below:
# -----------------------------------------------------------------------------

# Provider Option A: Resend (Recommended)
RESEND_API_KEY=AIzaSyXXXXXXXXXXXXXXXX

# Provider Option B: SMTP / Nodemailer (Alternative)
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-gmail-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Sender address displayed in recipient's inbox
EMAIL_FROM="Codevora AI" <notifications@your-registered-domain.com>

# -----------------------------------------------------------------------------
# 4. Public URLs (Required for Production Emails)
# Never use localhost in production emails.
# -----------------------------------------------------------------------------
# The canonical public HTTPS URL where your frontend is hosted (e.g. https://codevora.ai)
APP_PUBLIC_URL=AIzaSyXXXXXXXXXXXXXXXX
# Optional: Direct public HTTPS URL to your hosted logo image (PNG/SVG)
# Must be accessible over public HTTPS (e.g. from Supabase Storage or CDN)
PUBLIC_LOGO_URL=AIzaSyXXXXXXXXXXXXXXXX